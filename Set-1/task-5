def find_pairs(values, target):
    left = 0
    right = len(values) - 1
    pairs = []
    while left < right:
        total = values[left] + values[right]
        if total == target:
            pairs.append((values[left], values[right]))
            current_left = values[left]
            current_right = values[right]
            while left < right and values[left] == current_left:
                left += 1
            while left < right and values[right] == current_right:
                right -= 1
        elif total < target:
            left += 1
        else:
            right -= 1
    return pairs
order_values = [150, 200, 250, 300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 800, 850]
gift_card_value = 1000
pairs = find_pairs(order_values, gift_card_value)
print("Sorted order values:", order_values)
print("Gift-card target:", gift_card_value)
print("Matching distinct value pairs:", pairs)
print("Total pairs:", len(pairs))
